   "source": [
    "# Annuity Plan Program\n",
    "\n",
    "P = float(input(\"Enter payment per period: \"))\n",
    "r = float(input(\"Enter interest rate per period: \"))\n",
    "n = int(input(\"Enter number of payments: \"))\n",
    "\n",
    "FV = P * ((1 + r) ** n - 1) / r\n",
    "\n",
    "print(\"Future Value of Annuity =\", FV)"
   ]
  }
