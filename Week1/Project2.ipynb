   ],
   "source": [
    "# Compound Interest Program\n",
    "\n",
    "P = float(input(\"Enter Principal: \"))\n",
    "R = float(input(\"Enter Rate of Interest: \"))\n",
    "T = float(input(\"Enter Time (years): \"))\n",
    "\n",
    "A = P * (1 + R/100) ** T\n",
    "CI = A - P\n",
    "\n",
    "print(\"Compound Interest =\", CI)\n",
    "print(\"Total Amount =\", A)"
   ]
  }
 ],
