   "source": [
    "# Simple Interest Program\n",
    "\n",
    "P = float(input(\"Enter Principal: \"))\n",
    "R = float(input(\"Enter Rate of Interest: \"))\n",
    "T = float(input(\"Enter Time (years): \"))\n",
    "\n",
    "SI = (P * R * T) / 100\n",
    "\n",
    "print(\"Simple Interest =\", SI)"
   ]
  }
